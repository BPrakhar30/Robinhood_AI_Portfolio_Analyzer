# Production/free-tier deployment example.
# Keep AI keys empty until you are ready to enable AI features.

APP_NAME=RobinhoodAICopilot
APP_ENV=production
DEBUG=false

# Render backend URL must be replaced after backend deploy.
FRONTEND_URL=https://your-cloudflare-project.pages.dev
NEXT_PUBLIC_API_URL=https://your-render-service.onrender.com
NEXT_PUBLIC_ENABLE_PLAID=false

# Generate these locally. Do not commit real values.
# SECRET_KEY/JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase Free Postgres. Use async URL for runtime and sync URL for Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DATABASE_URL_SYNC=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Single-container backend/MCP deployment.
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# Public registration stays off until SMTP is proven.
ENABLE_PUBLIC_REGISTRATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.example
SMTP_USE_TLS=true

# Seed one verified user so the public deployment can be tested immediately.
SEED_DEMO_USER=true
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
RESET_DEMO_USER_PASSWORD=false

# Optional integrations remain disabled by default.
ENABLE_PLAID=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

ENABLE_FINNHUB=false
FINNHUB_API_KEY=
POLYGON_API_KEY=
YAHOO_FINANCE_FALLBACK=true

# AI features stay visible but disabled until keys are added.
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=

# No cloud tracing by default.
LOGFIRE_TOKEN=
LOGFIRE_CONSOLE=false
LOGFIRE_SCRUB_PROMPTS=true

# Redis is optional. Empty/default means in-memory rate limiting.
REDIS_URL=redis://localhost:6379/0
