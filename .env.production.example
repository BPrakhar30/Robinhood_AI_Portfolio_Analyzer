# ─────────────────────────────────────────────────────────────────────────────
# Production .env template
# Copy this to .env on the VPS and fill in every value marked <REPLACE>.
# NEVER commit the filled .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=RobinhoodAICopilot
APP_ENV=production
DEBUG=false

# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<REPLACE: strong random hex string>

# ── Domain ────────────────────────────────────────────────────────────────────
# Your domain WITHOUT https:// — used by Caddy for TLS provisioning
DOMAIN=yourdomain.com

# Full HTTPS URL — used by the backend for CORS and email links,
# and baked into the Next.js client bundle as the API base URL.
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Generate a strong password:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=<REPLACE: strong random password>

# These are set automatically by docker-compose.prod.yml using POSTGRES_PASSWORD above.
# You do NOT need to change the hostname (postgres = Docker service name).
DATABASE_URL=postgresql+asyncpg://postgres:<REPLACE: same as POSTGRES_PASSWORD>@postgres:5432/robinhood_ai
DATABASE_URL_SYNC=postgresql://postgres:<REPLACE: same as POSTGRES_PASSWORD>@postgres:5432/robinhood_ai

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<REPLACE: strong random hex string>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Encryption (Fernet) ───────────────────────────────────────────────────────
# Generate with:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<REPLACE: Fernet key>

# ── AI Assistant (Google Gemini — free tier) ──────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=<REPLACE>
GOOGLE_MODEL=gemini-2.5-flash

# MCP tool server — keep this as-is (Docker internal hostname)
MCP_SERVER_URL=http://mcp-server:8765/mcp

# ── Market Data ───────────────────────────────────────────────────────────────
# Free key at https://finnhub.io/register
FINNHUB_API_KEY=<REPLACE>
YAHOO_FINANCE_FALLBACK=true
# Fetch live quotes for CSV/Excel imports that omit current_price.
# Set to false if you want imports to be faster and don't need live prices on upload.
CSV_LIVE_PRICE_ENRICHMENT=true

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Required for email verification and password reset in production.
# Gmail option: enable 2FA on your Google account, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<REPLACE: your@gmail.com>
SMTP_PASSWORD=<REPLACE: Gmail App Password (16 chars)>
SMTP_FROM_EMAIL=<REPLACE: your@gmail.com>
SMTP_USE_TLS=true

# ── Broker Integrations (optional) ───────────────────────────────────────────
ROBINHOOD_CLIENT_ID=
ROBINHOOD_DEVICE_TOKEN=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# ── Observability (optional) ──────────────────────────────────────────────────
# Leave empty to disable cloud tracing. Free tier at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_CONSOLE=false
LOGFIRE_SCRUB_PROMPTS=false

# ── Redis (optional) ─────────────────────────────────────────────────────────
# If not set, rate limiter falls back to in-memory (fine for a single VPS).
# REDIS_URL=redis://localhost:6379/0
