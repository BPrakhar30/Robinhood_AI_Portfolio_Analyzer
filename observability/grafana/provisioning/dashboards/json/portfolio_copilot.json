{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests / min",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(portfolio_assistant_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "p95 assistant latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(portfolio_assistant_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Tokens by user (last hour)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user_id) (increase(portfolio_assistant_tokens_total[1h]))",
          "legendFormat": "{{user_id}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Tool calls by user (last hour)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user_id) (increase(portfolio_assistant_tool_calls_total[1h]))",
          "legendFormat": "{{user_id}}"
        }
      ],
      "id": 4
    },
    {
      "type": "table",
      "title": "Requests by user (last 24h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "custom.width", "value": 200 }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user_id) (increase(portfolio_assistant_requests_total[24h]))",
          "format": "table",
          "instant": true
        }
      ],
      "id": 5
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["portfolio-copilot"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Portfolio Copilot",
  "uid": "portfolio-copilot",
  "version": 1
}
