# Application
APP_NAME=RobinhoodAICopilot
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL via docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/robinhood_ai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/robinhood_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption Key (Fernet) - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Robinhood
ROBINHOOD_CLIENT_ID=
ROBINHOOD_DEVICE_TOKEN=

# Plaid
ENABLE_PLAID=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Market Data
ENABLE_FINNHUB=false
POLYGON_API_KEY=
FINNHUB_API_KEY=
YAHOO_FINANCE_FALLBACK=true

# Auth / Email
ENABLE_PUBLIC_REGISTRATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@robinhoodai.local
SMTP_USE_TLS=true

# Public demo seed (for free public deployments)
SEED_DEMO_USER=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
RESET_DEMO_USER_PASSWORD=false

# LLM - leave API keys empty until you are ready to enable AI features
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Legacy optional provider fields
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# MCP server URL. Docker default shown; use http://localhost:8765/mcp bare-metal.
MCP_SERVER_URL=http://mcp-server:8765/mcp

# Observability - leave token empty to avoid cloud shipping
LOGFIRE_TOKEN=
LOGFIRE_CONSOLE=true
LOGFIRE_SCRUB_PROMPTS=false

# Frontend build/runtime
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_PLAID=false
