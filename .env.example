# Application
APP_NAME=RobinhoodAICopilot
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Database (PostgreSQL via docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/robinhood_ai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/robinhood_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption Key (Fernet) - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Robinhood
ROBINHOOD_CLIENT_ID=
ROBINHOOD_DEVICE_TOKEN=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Market Data
POLYGON_API_KEY=
FINNHUB_API_KEY=
YAHOO_FINANCE_FALLBACK=true
# Fetch live quotes for CSV/Excel imports that omit current_price
CSV_LIVE_PRICE_ENRICHMENT=true

# LLM (future use)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# AI Assistant (PydanticAI + OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# MCP server URL. Docker default shown; use http://localhost:8765/mcp bare-metal.
MCP_SERVER_URL=http://mcp-server:8765/mcp

# ── Observability ─────────────────────────────────────────────────────────────
# Pydantic Logfire cloud token (optional). Leave empty to disable cloud export.
LOGFIRE_TOKEN=
# Print spans to the console in dev for quick inspection.
LOGFIRE_CONSOLE=true
# Scrub prompts/user questions from observability exports (finance mode).
LOGFIRE_SCRUB_PROMPTS=false
# Self-hosted OpenTelemetry endpoint (traces + metrics + logs via OTLP/HTTP).
# When set, Logfire exports here instead of its cloud. Point at the local
# collector from observability/docker-compose.yml:
#   http://localhost:4318            (app runs natively on the host)
#   http://host.docker.internal:4318 (app runs in its own docker-compose)
OTEL_EXPORTER_OTLP_ENDPOINT=
